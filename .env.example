# N8N Bitbucket PR Analysis Workflow 环境变量配置示例
# 复制此文件为 .env 并填入实际的值

# ==================== Bitbucket 配置 ====================
# Bitbucket 工作空间名称（从 URL 中获取：https://bitbucket.org/{workspace}/{repo}）
BITBUCKET_WORKSPACE=your_workspace_name

# Bitbucket 仓库名称
BITBUCKET_REPO=your_repository_name

# Bitbucket 用户名（通常是你的邮箱或用户名）
BITBUCKET_USERNAME=your_username

# Bitbucket App Password（在 Bitbucket Settings → App passwords 中创建）
# 权限需要：pullrequest:read, repository:read
BITBUCKET_APP_PASSWORD=your_app_password


# ==================== 千问 API 配置 ====================
# 千问 API Key（从阿里云 DashScope 获取：https://dashscope.console.aliyun.com/）
# 格式：sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QIANWEN_API_KEY=sk-your-api-key-here


# ==================== 飞书多维表格配置 ====================
# 飞书 App ID（从飞书开放平台获取：https://open.feishu.cn/app）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx

# 飞书 App Secret（从飞书开放平台获取）
FEISHU_APP_SECRET=your_app_secret

# 飞书多维表格 App Token（从飞书多维表格 URL 中获取）
# URL 格式：https://xxx.feishu.cn/base/{app_token}
FEISHU_APP_TOKEN=bascnxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书多维表格 Table ID（从飞书多维表格 URL 中获取）
# URL 格式：https://xxx.feishu.cn/base/{app_token}?table={table_id}
FEISHU_TABLE_ID=tblxxxxxxxxxxxxxxxxxx


# ==================== 可选配置 ====================
# PR 分析的源分支（可选，为空则分析所有分支）
BITBUCKET_SOURCE_BRANCH=

# PR 分析的目标分支（可选，为空则分析所有分支）
BITBUCKET_DESTINATION_BRANCH=main

# 最大代码 diff 长度（字符数，避免超过 AI token 限制）
MAX_DIFF_LENGTH=8000

# 千问模型名称（可选：qwen-max, qwen-plus, qwen-turbo）
QIANWEN_MODEL=qwen-max

# AI 温度参数（0.0-1.0，越低越保守）
AI_TEMPERATURE=0.3
