{
  "credentials_guide": {
    "description": "这是 N8N workflow 所需的凭据配置指南",
    "version": "1.115.3",
    "credentials": [
      {
        "id": "bitbucket-basic-auth",
        "name": "Bitbucket Credentials",
        "type": "httpBasicAuth",
        "configuration": {
          "username": "your_bitbucket_username",
          "password": "your_bitbucket_app_password"
        },
        "how_to_get": {
          "steps": [
            "1. 登录 Bitbucket (https://bitbucket.org)",
            "2. 点击右上角头像 → Personal settings",
            "3. 左侧菜单选择 App passwords",
            "4. 点击 Create app password",
            "5. 输入名称（如：N8N Workflow）",
            "6. 选择权限：",
            "   - Repositories: Read",
            "   - Pull requests: Read",
            "7. 点击 Create，复制生成的密码"
          ],
          "note": "App Password 只显示一次，请妥善保存"
        }
      },
      {
        "id": "qianwen-api-key",
        "name": "Qianwen API Key",
        "type": "httpHeaderAuth",
        "configuration": {
          "header_name": "Authorization",
          "header_value": "Bearer sk-your-api-key-here"
        },
        "how_to_get": {
          "steps": [
            "1. 访问阿里云 DashScope 控制台",
            "   https://dashscope.console.aliyun.com/",
            "2. 登录阿里云账号",
            "3. 进入 API-KEY 管理页面",
            "4. 点击创建新的 API-KEY",
            "5. 复制生成的 API Key",
            "6. 在 N8N 中配置时，格式为：Bearer sk-xxxxx"
          ],
          "note": "确保账户有足够的余额用于 API 调用"
        }
      },
      {
        "id": "feishu-access-token",
        "name": "Feishu Access Token",
        "type": "httpHeaderAuth",
        "configuration": {
          "header_name": "Authorization",
          "header_value": "Bearer t-xxxxxxxxxxxxxxxxxxxxx"
        },
        "how_to_get": {
          "steps": [
            "1. 访问飞书开放平台 (https://open.feishu.cn/)",
            "2. 创建企业自建应用",
            "3. 进入应用详情 → 凭证与基础信息",
            "4. 获取 App ID 和 App Secret",
            "5. 添加应用权限：",
            "   - bitable:app (多维表格应用访问)",
            "   - bitable:record:write (记录写入权限)",
            "6. 使用以下 API 获取 access_token：",
            "   POST https://open.feishu.cn/open-apis/auth/v3/tenant_access_token/internal",
            "   Body: { \"app_id\": \"xxx\", \"app_secret\": \"xxx\" }",
            "7. 在 N8N 中配置时，格式为：Bearer t-xxxxx"
          ],
          "note": "tenant_access_token 有效期为 2 小时，需要定期刷新",
          "alternative": "也可以使用 N8N 的 Feishu 节点自动处理 token 刷新"
        }
      }
    ],
    "test_credentials": {
      "bitbucket": {
        "test_command": "curl -u username:app_password https://api.bitbucket.org/2.0/user",
        "expected_response": "返回用户信息表示成功"
      },
      "qianwen": {
        "test_command": "curl -X POST https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation -H 'Authorization: Bearer YOUR_API_KEY' -H 'Content-Type: application/json' -d '{\"model\":\"qwen-turbo\",\"input\":{\"messages\":[{\"role\":\"user\",\"content\":\"你好\"}]}}'",
        "expected_response": "返回 AI 回复表示成功"
      },
      "feishu": {
        "test_command": "curl -X GET https://open.feishu.cn/open-apis/bitable/v1/apps/YOUR_APP_TOKEN/tables/YOUR_TABLE_ID/records -H 'Authorization: Bearer YOUR_ACCESS_TOKEN'",
        "expected_response": "返回表格记录列表表示成功"
      }
    }
  }
}
